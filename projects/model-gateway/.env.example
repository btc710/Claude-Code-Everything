# --- Server ---
PORT=8787
# Comma-separated tenant credentials: tenantId:bearerToken,tenantId2:bearerToken2
# In production these live in a secrets vault, NOT in .env.
ATLAS_TENANT_TOKENS=demo:demo-secret-replace-me

# --- Vendor keys (one per slot family) ---
# Anthropic — slots 1/2/3/4 (opus-4-7, sonnet-4-6, haiku-4-5, opus-4-6)
ANTHROPIC_API_KEY=

# OpenAI — slots 5/6 (gpt-5, gpt-5-mini)
OPENAI_API_KEY=

# Google AI Studio — slots 7/8 (gemini-2.5-pro, gemini-flash)
GOOGLE_API_KEY=

# xAI — slot 9 (grok-4)
XAI_API_KEY=

# Together AI (or any OpenAI-compatible Llama host) — slot 10 (llama-4-405b)
TOGETHER_API_KEY=

# Mistral — slot 11 (mistral-large)
MISTRAL_API_KEY=

# DeepSeek — slot 12 (deepseek-v3)
DEEPSEEK_API_KEY=
