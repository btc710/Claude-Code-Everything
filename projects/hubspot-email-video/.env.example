# HubSpot Private App token with scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.deals.read, crm.objects.deals.write, crm.objects.notes.write
HUBSPOT_TOKEN=

# Google OAuth: a refresh token for a service account or user with Calendar + Gmail send scopes.
# Required scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Default sender identity (the mailbox the OAuth token authorizes)
SENDER_EMAIL=
SENDER_NAME=

# Default calendar to create events on (use "primary" unless using a shared calendar)
CALENDAR_ID=primary

# Default duration for project-discussion meetings (minutes)
DEFAULT_MEETING_MINUTES=30

# IANA time zone for scheduling (e.g. America/Chicago, Europe/Berlin)
DEFAULT_TIMEZONE=America/Chicago
